# arcgame.app: the public website. The game itself is at https://play.arcgame.app.
#
# Redirects adapted from tools/site-holding/.htaccess (claude/arcgame-hosting),
# without its 302-to-play rule: arcgame.app now serves this site.
#
# The headers below are tied to the host name arcgame.app, like the redirects. If
# the game's folder (play.arcgame.app) sits inside public_html, Apache reads this
# file for its requests too, and the site's strict CSP and caching must not reach
# the game.

# No directory listings.
Options -Indexes

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Leave /.well-known/ alone on every host (certificate checks).
RewriteRule ^\.well-known(?:/|$) - [L]

# 2. arcgame.co.uk and www.arcgame.co.uk: 301 to https://arcgame.app, same path and query.
RewriteCond %{HTTP_HOST} ^(?:www\.)?arcgame\.co\.uk(?::\d+)?$ [NC]
RewriteRule ^(.*)$ https://arcgame.app/$1 [R=301,L]

# 3. www.arcgame.app: 301 to https://arcgame.app, same path and query.
RewriteCond %{HTTP_HOST} ^www\.arcgame\.app(?::\d+)?$ [NC]
RewriteRule ^(.*)$ https://arcgame.app/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
<If "%{HTTP_HOST} =~ /^arcgame\.app(:\d+)?$/i">
  # Everything comes from this site. No third parties, no inline code.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Pages are always checked for a newer copy.
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Images, CSS and fonts: one hour.
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|css|woff2)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</If>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
