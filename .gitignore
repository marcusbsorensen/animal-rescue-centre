# Playwright e2e artefacts — reports, traces, actual/diff images.
# Committed baseline screenshots under e2e/__screenshots__/ stay tracked.
apps/game/playwright-report/
apps/game/test-results/
apps/game/e2e/__screenshots__/**/*-actual.png
apps/game/e2e/__screenshots__/**/*-diff.png

# Rear-view mirror mood sprites are composited from existing animal art
# by tools/build-mirror-mood-sprites.ts. Index is tracked; PNGs are not.
apps/game/public/assets/driving/mirror-moods/*.png

# Scratch from Claude Preview MCP sessions
.playwright-mcp/

# Loose QA/dev screenshots dropped in the repo root (qa-*, map-*, pass-*,
# final-*, verify-* etc.). Root-only rule — real assets live under
# apps/game/public/ and asset-drafts/ and are unaffected. Files stay on
# disk; this just stops them polluting `git status`.
/*.png
