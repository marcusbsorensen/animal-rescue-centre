{
  "name": "arc",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "A.R.C. — Animal Rescue Centre",
  "scripts": {
    "dev": "pnpm --filter @arc/game dev",
    "build": "pnpm -r --filter '!@arc/admin' build",
    "build:admin-local": "ARC_ADMIN_LOCAL_BUILD=1 pnpm --filter @arc/admin build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "build:ios": "node scripts/build-ios.mjs",
    "ios": "pnpm build:ios && pnpm --filter @arc/game exec cap open ios"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^9.39.4",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.58.1"
  }
}
